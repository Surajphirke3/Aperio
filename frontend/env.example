# Frontend environment example
# This app currently tries Featherless first and falls back to Ollama.
# There is no AI_PROVIDER switch in the current frontend codebase.

# Required for Prisma and server-side database queries
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traceflow

# Required if you want Featherless to work
FEATHERLESS_API_KEY=your_featherless_api_key

# Optional Featherless overrides
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Optional local fallback via Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# App runtime
NODE_ENV=development
