# Backend environment example

# AI provider
# Use "featherless" for cloud inference or "ollama" for local inference
AI_PROVIDER=featherless

# Required when AI_PROVIDER=featherless
FEATHERLESS_API_KEY=your_featherless_api_key

# Used when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Featherless model selection
PRIMARY_MODEL=meta-llama/Llama-3.2-3B-Instruct
FALLBACK_MODEL=Qwen/Qwen2.5-3B-Instruct

# Database
# Current backend defaults and Alembic config are aligned with SQLite
DATABASE_URL=sqlite:///./traceflow.db

# App
ENVIRONMENT=development
DEBUG=false

# JSON array string parsed by pydantic-settings
CORS_ORIGINS=["http://localhost:3000"]
